SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SCOPES=read_products,write_products
SHOPIFY_APP_URL=https://your-tunnel-or-production-url
SHOPIFY_SESSION_DB_PATH=.data/shopify_sessions.sqlite

# Existing ZestGPT Replicate proxy
AI_API_BASE_URL=https://ai.zestgpt.com
AI_MODEL=google/nano-banana

# Backend quota API. Defaults to AI_API_BASE_URL if omitted.
SHOPIFY_USAGE_API_BASE_URL=https://ai.zestgpt.com
SHOPIFY_INTERNAL_API_KEY=

# Keep true while testing with a Shopify development store.
SHOPIFY_BILLING_TEST=true

# Keep false while developing core image workflows. Set true when testing Billing.
SHOPIFY_BILLING_ENABLED=false

# Optional local override for testing paid quotas while Billing is disabled.
# Values: Free, Starter, Pro, Business
SHOPIFY_DEV_PLAN=Free
