{
  "name": "zest-ai-logo-creator",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "dev:remix": "remix vite:dev --host 0.0.0.0",
    "start": "node -r dotenv/config ./node_modules/@remix-run/serve/dist/cli.js ./build/server/index.js",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@remix-run/dev": "^2.17.0",
    "@remix-run/node": "^2.17.0",
    "@remix-run/react": "^2.17.0",
    "@remix-run/serve": "^2.17.4",
    "@shopify/app-bridge-react": "^4.2.0",
    "@shopify/polaris": "^13.9.5",
    "@shopify/shopify-app-remix": "^4.2.1",
    "@shopify/shopify-app-session-storage-sqlite": "^6.0.1",
    "@vercel/remix": "2.16.7",
    "isbot": "^5.1.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.19"
  },
  "devDependencies": {
    "@shopify/cli": "^3.85.4",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "eslint": "^8.57.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/remix": {
      "@remix-run/dev": "$@remix-run/dev",
      "@remix-run/node": "$@remix-run/node",
      "@remix-run/server-runtime": "2.17.5"
    }
  }
}
